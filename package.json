{
  "name": "@eye-security-interview/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "cli",
    "contracts",
    "api"
  ],
  "scripts": {
    "api:dev": "bun run --filter @eye-security-interview/api dev",
    "api:start": "bun run --filter @eye-security-interview/api start",
    "check": "bun run --workspaces check",
    "cli": "bun run --env-file=cli/.env cli/src/index.ts",
    "db:down": "docker compose --env-file api/.env down",
    "db:up": "docker compose --env-file api/.env up --detach --wait postgres",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "bun test"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "catalog": {
    "zod": "4.6.5"
  }
}
